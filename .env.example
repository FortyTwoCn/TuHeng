# 从项目根目录启动。请使用明确支持图像输入的模型和 Chat Completions 端点。
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=
AI_TIMEOUT_SECONDS=120
AI_MAX_RETRIES=2
# json_object / json_schema / none；兼容服务不支持结构化参数时可改为 none。
AI_RESPONSE_FORMAT=json_object
AI_MAX_OUTPUT_TOKENS=6000
AI_MAX_IMAGE_SIDE=1600
AI_MAX_IMAGE_BYTES=1500000
AI_MAX_REQUEST_BYTES=18000000
# 默认仅会话内记录。启用后会落盘匿名摘要和原始模型响应，响应也可能含个人信息。
PERSIST_LOCAL_LOGS=false
LOCAL_LOG_DIR=artifacts
