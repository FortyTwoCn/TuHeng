DATABASE_URL=postgresql://tuheng:tuheng_local@localhost:5432/tuheng
REDIS_URL=redis://localhost:6379
NEXTAUTH_URL=http://localhost:3000
# Optional exact origins (comma-separated) for LAN aliases, e.g. http://192.168.1.100:3000
APP_ALLOWED_ORIGINS=
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# Only isolated automated test databases may set SEED_TEST_ACCOUNTS=1.
SEED_TEST_ACCOUNTS=0
SEED_PASSWORD=replace-with-a-local-test-password
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=tuheng-private
S3_ACCESS_KEY=tuheng_local
S3_SECRET_KEY=tuheng_local_secret
WORKER_SELFTEST_CONCURRENCY=2
UPLOAD_MAX_BYTES=15728640
SELFTEST_DAILY_QUOTA=20

# SecretStore: JSON mapping keyId to base64-encoded random 32-byte keys; keep outside DB.
TUHENG_SECRET_KEYS={}
TUHENG_SECRET_ACTIVE_KEY=
# Exact host:port allowlist only for controlled internal SMTP/model endpoints.
TUHENG_OUTBOUND_ALLOWLIST=
# Set 1 only behind a trusted proxy that overwrites X-Real-IP and prevents direct access.
TUHENG_TRUST_PROXY_IP=0
WORKER_FORMAL_CONCURRENCY=4
