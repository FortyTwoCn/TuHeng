generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String              @id @default(uuid())
  email                String
  name                 String
  passwordHash         String
  roles                String[]
  active               Boolean             @default(true)
  tokenVersion         Int                 @default(0)
  createdAt            DateTime            @default(now())
  kind                 String              @default("STUDENT")
  realm                String              @default("STUDENT")
  loginId              String?             @unique
  schoolId             String?
  studentNumber        String?
  emailNormalized      String?
  emailVerifiedAt      DateTime?
  mustChangePassword   Boolean             @default(true)
  passwordExpiresAt    DateTime?
  credentialVersion    Int                 @default(0)
  lastLoginAt          DateTime?
  installationComplete Boolean             @default(false)
  school               School?             @relation(fields: [schoolId], references: [id])
  enrollments          Enrollment[]
  grants               TeachingGrant[]
  questions            Question[]
  assets               StoredAsset[]
  submissions          Submission[]
  attempts             SubmissionAttempt[]
  decisions            GradeDecision[]
  appeals              Appeal[]
  folders              SelfTestFolder[]
  sets                 SelfTestSet[]
  errors               ErrorBookEntry[]
  evidence             KnowledgeEvidence[]
  audits               AuditLog[]

  @@unique([realm, emailNormalized])
  @@unique([schoolId, studentNumber])
  @@index([schoolId, kind, active])
  @@index([active])
}

model Course {
  id        String           @id @default(uuid())
  title     String
  code      String           @unique
  schoolId  String?
  offerings CourseOffering[]
  questions Question[]
}

model CourseOffering {
  id       String          @id @default(uuid())
  courseId String
  term     String
  course   Course          @relation(fields: [courseId], references: [id])
  classes  TeachingClass[]

  @@unique([courseId, term])
}

model TeachingClass {
  id          String          @id @default(uuid())
  offeringId  String
  schoolId    String?
  archived    Boolean         @default(false)
  createdAt   DateTime        @default(now())
  name        String
  offering    CourseOffering  @relation(fields: [offeringId], references: [id])
  enrollments Enrollment[]
  grants      TeachingGrant[]
  assignments Assignment[]

  @@index([offeringId])
}

model Enrollment {
  id            String        @id @default(uuid())
  userId        String
  classId       String
  user          User          @relation(fields: [userId], references: [id])
  teachingClass TeachingClass @relation(fields: [classId], references: [id])

  @@unique([userId, classId])
  @@index([classId])
}

model TeachingGrant {
  id            String        @id @default(uuid())
  userId        String
  classId       String
  user          User          @relation(fields: [userId], references: [id])
  teachingClass TeachingClass @relation(fields: [classId], references: [id])

  @@unique([userId, classId])
  @@index([classId])
}

model KnowledgePoint {
  id       String              @id @default(uuid())
  title    String
  chapter  String
  evidence KnowledgeEvidence[]
}

model Question {
  id         String            @id @default(uuid())
  ownerId    String
  courseId   String?
  visibility String            @default("PRIVATE")
  active     Boolean           @default(true)
  createdAt  DateTime          @default(now())
  owner      User              @relation(fields: [ownerId], references: [id])
  course     Course?           @relation(fields: [courseId], references: [id])
  versions   QuestionVersion[]

  @@index([ownerId, active])
}

model QuestionVersion {
  id               String              @id @default(uuid())
  questionId       String
  version          Int
  title            String
  content          String
  type             String
  chapter          String
  maxPoints        Int
  knowledgeIds     String[]
  assetIds         String[]
  reference        Json
  rubric           Json
  analysis         Json?
  geometryDocument Json?
  confirmed        Boolean             @default(false)
  createdAt        DateTime            @default(now())
  question         Question            @relation(fields: [questionId], references: [id])
  items            AssignmentItem[]
  selfItems        SelfTestItem[]
  attempts         SubmissionAttempt[]
  errors           ErrorBookEntry[]

  @@unique([questionId, version])
}

model Assignment {
  id               String           @id @default(uuid())
  classId          String?
  schoolId         String?
  audience         Json?
  audienceRevision Int              @default(0)
  creatorId        String
  title            String
  status           String           @default("DRAFT")
  startsAt         DateTime
  dueAt            DateTime
  allowLate        Boolean          @default(false)
  maxAttempts      Int              @default(1)
  releaseAnswers   Boolean          @default(false)
  createdAt        DateTime         @default(now())
  teachingClass    TeachingClass?   @relation(fields: [classId], references: [id])
  items            AssignmentItem[]

  @@index([classId, status, dueAt])
}

model AssignmentItem {
  id                String          @id @default(uuid())
  assignmentId      String
  questionVersionId String
  position          Int
  assignment        Assignment      @relation(fields: [assignmentId], references: [id])
  questionVersion   QuestionVersion @relation(fields: [questionVersionId], references: [id])
  submissions       Submission[]

  @@unique([assignmentId, position])
}

model Submission {
  id            String              @id @default(uuid())
  userId        String
  itemId        String
  draftAssetIds String[]
  draftGeometry Json?
  attempts      SubmissionAttempt[]
  user          User                @relation(fields: [userId], references: [id])
  item          AssignmentItem      @relation(fields: [itemId], references: [id])

  @@unique([userId, itemId])
}

model SubmissionAttempt {
  id                    String            @id @default(uuid())
  ownerId               String
  submissionId          String?
  questionVersionId     String
  selfTestItemId        String?
  version               Int
  idempotencyKey        String
  source                String
  submittedAt           DateTime          @default(now())
  publishedDecisionId   String?           @unique
  geometryAnswer        Json?
  geometrySchemaVersion String?
  owner                 User              @relation(fields: [ownerId], references: [id])
  submission            Submission?       @relation(fields: [submissionId], references: [id])
  questionVersion       QuestionVersion   @relation(fields: [questionVersionId], references: [id])
  selfTestItem          SelfTestItem?     @relation(fields: [selfTestItemId], references: [id])
  assets                SubmissionAsset[]
  runs                  GradingRun[]
  decisions             GradeDecision[]   @relation("AttemptDecisions")
  publishedDecision     GradeDecision?    @relation("PublishedDecision", fields: [publishedDecisionId], references: [id])
  appeals               Appeal[]
  errors                ErrorBookEntry[]
  reviews               ReviewAttempt[]

  @@unique([ownerId, idempotencyKey])
  @@unique([submissionId, version])
  @@index([ownerId, submittedAt])
}

model SubmissionAsset {
  id        String            @id @default(uuid())
  attemptId String
  assetId   String
  position  Int
  attempt   SubmissionAttempt @relation(fields: [attemptId], references: [id])
  asset     StoredAsset       @relation(fields: [assetId], references: [id])

  @@unique([attemptId, position])
}

model StoredAsset {
  id          String            @id @default(uuid())
  ownerId     String
  objectKey   String            @unique
  name        String
  mime        String
  bytes       Int
  width       Int?
  height      Int?
  purpose     String
  parentId    String?
  transform   Json?
  createdAt   DateTime          @default(now())
  owner       User              @relation(fields: [ownerId], references: [id])
  submissions SubmissionAsset[]

  @@index([ownerId, createdAt])
}

model ModelConfigurationVersion {
  id          String       @id @default(uuid())
  provider    String
  baseUrl     String
  model       String
  outputMode  String
  timeoutMs   Int
  concurrency Int
  keyEnv      String       @default("AI_API_KEY")
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  runs        GradingRun[]
}

model GradingRun {
  id              String                     @id @default(uuid())
  attemptId       String
  configId        String?
  status          String                     @default("QUEUED")
  strategyVersion String
  promptVersion   String
  request         Json
  errorCode       String?
  leaseUntil      DateTime?
  leaseToken      String?
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime                   @default(now())
  attempt         SubmissionAttempt          @relation(fields: [attemptId], references: [id])
  config          ModelConfigurationVersion? @relation(fields: [configId], references: [id])
  suggestion      GradingSuggestion?
  job             BackgroundJob?

  @@index([status, leaseUntil])
  @@index([attemptId, createdAt])
}

model GradingSuggestion {
  id              String     @id @default(uuid())
  runId           String     @unique
  result          Json
  rawResponse     Json
  processedAssets Json
  createdAt       DateTime   @default(now())
  run             GradingRun @relation(fields: [runId], references: [id])
}

model GradeDecision {
  id           String              @id @default(uuid())
  attemptId    String
  teacherId    String
  revision     Int
  points       Int
  items        Json
  feedback     String
  annotations  Json
  aiIncorrect  Boolean             @default(false)
  publishedAt  DateTime?
  createdAt    DateTime            @default(now())
  attempt      SubmissionAttempt   @relation("AttemptDecisions", fields: [attemptId], references: [id])
  publishedFor SubmissionAttempt?  @relation("PublishedDecision")
  teacher      User                @relation(fields: [teacherId], references: [id])
  evidence     KnowledgeEvidence[]

  @@unique([attemptId, revision])
}

model Appeal {
  id        String            @id @default(uuid())
  attemptId String
  userId    String
  reason    String
  status    String            @default("OPEN")
  response  String?
  createdAt DateTime          @default(now())
  attempt   SubmissionAttempt @relation(fields: [attemptId], references: [id])
  user      User              @relation(fields: [userId], references: [id])

  @@index([status, attemptId])
}

model SelfTestFolder {
  id      String        @id @default(uuid())
  ownerId String
  title   String
  owner   User          @relation(fields: [ownerId], references: [id])
  sets    SelfTestSet[]

  @@index([ownerId])
}

model SelfTestSet {
  id        String          @id @default(uuid())
  ownerId   String
  folderId  String?
  title     String
  mode      String
  createdAt DateTime        @default(now())
  owner     User            @relation(fields: [ownerId], references: [id])
  folder    SelfTestFolder? @relation(fields: [folderId], references: [id])
  items     SelfTestItem[]

  @@index([ownerId])
}

model SelfTestItem {
  id                String              @id @default(uuid())
  setId             String
  questionVersionId String
  position          Int
  set               SelfTestSet         @relation(fields: [setId], references: [id])
  questionVersion   QuestionVersion     @relation(fields: [questionVersionId], references: [id])
  attempts          SubmissionAttempt[]

  @@unique([setId, position])
}

model ErrorBookEntry {
  id                String            @id @default(uuid())
  ownerId           String
  questionVersionId String
  attemptId         String
  archived          Boolean           @default(false)
  createdAt         DateTime          @default(now())
  owner             User              @relation(fields: [ownerId], references: [id])
  questionVersion   QuestionVersion   @relation(fields: [questionVersionId], references: [id])
  attempt           SubmissionAttempt @relation(fields: [attemptId], references: [id])
  reviews           ReviewAttempt[]

  @@unique([ownerId, attemptId])
  @@index([ownerId, archived])
}

model ReviewAttempt {
  id        String            @id @default(uuid())
  entryId   String
  attemptId String            @unique
  entry     ErrorBookEntry    @relation(fields: [entryId], references: [id])
  attempt   SubmissionAttempt @relation(fields: [attemptId], references: [id])
}

model KnowledgeEvidence {
  id          String         @id @default(uuid())
  ownerId     String
  knowledgeId String
  decisionId  String
  earned      Int
  possible    Int
  evidence    String
  owner       User           @relation(fields: [ownerId], references: [id])
  knowledge   KnowledgePoint @relation(fields: [knowledgeId], references: [id])
  decision    GradeDecision  @relation(fields: [decisionId], references: [id])

  @@unique([decisionId, knowledgeId])
  @@index([ownerId, knowledgeId])
}

model BackgroundJob {
  id        String     @id @default(uuid())
  runId     String     @unique
  lane      String
  status    String     @default("QUEUED")
  attempts  Int        @default(0)
  errorCode String?
  updatedAt DateTime   @updatedAt
  run       GradingRun @relation(fields: [runId], references: [id])

  @@index([status, updatedAt])
}

model OutboxEvent {
  id          String    @id @default(uuid())
  runId       String    @unique
  lane        String
  deliveredAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([deliveredAt, createdAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  action     String
  resourceId String
  details    Json
  createdAt  DateTime @default(now())
  actor      User     @relation(fields: [actorId], references: [id])

  @@index([actorId, createdAt])
}

model LoginThrottle {
  id           String    @id
  failures     Int       @default(0)
  blockedUntil DateTime?
  updatedAt    DateTime  @updatedAt
}

model School {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  active        Boolean  @default(true)
  rosterVersion Int      @default(0)
  createdAt     DateTime @default(now())
  users         User[]
}

model IdentitySequence {
  id    String @id
  value Int    @default(0)
}

model VerificationChallenge {
  id          String    @id @default(uuid())
  realm       String
  purpose     String
  accountId   String
  targetEmail String
  digest      String
  expiresAt   DateTime
  failures    Int       @default(0)
  consumedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([realm, purpose, accountId, createdAt])
}

model SecurityThrottle {
  id        String   @id
  count     Int      @default(0)
  expiresAt DateTime
}

model Reauthentication {
  id           String   @id
  accountId    String
  realm        String
  tokenVersion Int
  expiresAt    DateTime
}

model SecretRecord {
  id         String    @id @default(uuid())
  purpose    String
  keyId      String
  nonce      String
  ciphertext String
  tag        String
  suffix     String
  revokedAt  DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
}

model SMTPConfigurationVersion {
  id        String   @id @default(uuid())
  version   Int      @unique
  config    Json
  secretId  String?
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model EmailDelivery {
  id          String   @id @default(uuid())
  challengeId String?  @unique
  smtpId      String
  purpose     String
  status      String   @default("PENDING")
  errorCode   String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())
}

model CredentialDeliveryBatch {
  id        String                   @id @default(uuid())
  creatorId String
  schoolId  String?
  expiresAt DateTime
  createdAt DateTime                 @default(now())
  items     CredentialDeliveryItem[]
}

model CredentialDeliveryItem {
  id                String                  @id @default(uuid())
  batchId           String
  accountId         String
  credentialVersion Int
  secretId          String
  expiresAt         DateTime
  batch             CredentialDeliveryBatch @relation(fields: [batchId], references: [id])

  @@unique([batchId, accountId])
}

model CredentialDownload {
  id         String    @id
  batchId    String
  actorId    String
  kind       String
  expiresAt  DateTime
  consumedAt DateTime?
}

model RosterImportBatch {
  id            String   @id @default(uuid())
  creatorId     String
  schoolId      String
  fingerprint   String
  scope         Json
  rows          Json
  mapping       Json
  rosterVersion Int
  status        String   @default("PREVIEW")
  result        Json?
  errorCode     String?
  createdAt     DateTime @default(now())

  @@unique([creatorId, schoolId, fingerprint])
}

model AssignmentRecipient {
  id           String   @id @default(uuid())
  assignmentId String
  studentId    String
  schoolId     String
  classIds     String[]
  reviewerIds  String[]
  revision     Int
  active       Boolean  @default(true)
  inferred     Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@unique([assignmentId, studentId])
  @@index([studentId, active])
}

model AIProvider {
  id             String              @id @default(uuid())
  name           String
  brand          String
  enabled        Boolean             @default(false)
  archived       Boolean             @default(false)
  currentVersion Int                 @default(1)
  createdAt      DateTime            @default(now())
  versions       AIProviderVersion[]
  models         AIModel[]
}

model AIProviderVersion {
  id         String     @id @default(uuid())
  providerId String
  version    Int
  config     Json
  secretId   String?
  createdAt  DateTime   @default(now())
  provider   AIProvider @relation(fields: [providerId], references: [id])

  @@unique([providerId, version])
}

model AIModel {
  id             String           @id @default(uuid())
  providerId     String
  name           String
  enabled        Boolean          @default(false)
  archived       Boolean          @default(false)
  currentVersion Int              @default(1)
  createdAt      DateTime         @default(now())
  provider       AIProvider       @relation(fields: [providerId], references: [id])
  versions       AIModelVersion[]
}

model AIModelVersion {
  id         String   @id @default(uuid())
  modelId    String
  version    Int
  config     Json
  testStatus Json
  createdAt  DateTime @default(now())
  model      AIModel  @relation(fields: [modelId], references: [id])

  @@unique([modelId, version])
}

model AITaskBindingVersion {
  id         String   @id @default(uuid())
  taskKey    String
  version    Int
  modelId    String
  parameters Json
  enabled    Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([taskKey, version])
}

model AIInvocation {
  id               String    @id @default(uuid())
  runId            String?   @unique
  taskKey          String
  schoolId         String?
  actorId          String
  resourceId       String
  snapshot         Json?
  status           String    @default("BLOCKED_CONFIG")
  attempts         Int       @default(0)
  inputTokens      Int?
  outputTokens     Int?
  durationMs       Int?
  errorCode        String?
  billingUncertain Boolean   @default(false)
  estimatedCost    Float?
  costCurrency     String?
  callAttempts     AIInvocationAttempt[]
  startedAt        DateTime?
  finishedAt       DateTime?
  createdAt        DateTime  @default(now())

  @@index([taskKey, schoolId, status])
}

model AIInvocationAttempt {
  id String @id @default(uuid())
  invocationId String
  ordinal Int
  providerId String
  modelId String
  status String
  inputTokens Int?
  outputTokens Int?
  durationMs Int?
  estimatedCost Float?
  costCurrency String?
  billingUncertain Boolean @default(false)
  errorCode String?
  createdAt DateTime @default(now())
  invocation AIInvocation @relation(fields: [invocationId], references: [id])
  @@unique([invocationId, ordinal])
  @@index([providerId, createdAt])
}
