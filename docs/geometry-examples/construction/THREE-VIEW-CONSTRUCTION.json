  "metadata": {
    "title": "长方体贯通孔 · 三视图"
  },
  "constructionAnimation": {
    "schemaVersion": "tuheng.construction-animation/1.0.0",
    "editorType": "THREE_VIEW",
    "title": "长方体贯通孔的三视图",
    "description": "从确定孔轴线开始，按长对正、高平齐、宽相等补齐三个投影，再整理线型。",
    "phases": [
      {
        "id": "datum",
        "order": 0,
        "title": "中心线与定位线"
      },
      {
        "id": "outline",
        "order": 1,
        "title": "主要形体轮廓"
      },
      {
        "id": "opening",
        "order": 2,
        "title": "贯通孔与不可见轮廓"
      },
      {
        "id": "finish",
        "order": 3,
        "title": "检查擦除与加深"
      }
    ],
    "steps": [
      {
        "id": "centers",
        "order": 0,
        "phaseId": "datum",
        "title": "确定孔中心和基准",
        "narration": "1. 在俯视图确定孔中心 O，过 O 作垂直相交的中心线。\n2. 将中心投影传到主视图和左视图，标明孔轴线。",
        "kind": "CENTERLINE",
        "entityIds": ["v-center-1", "h-center-x-1", "h-center-y-1", "w-center-1"],
        "focusPoints": [
          {
            "id": "O",
            "position": { "x": -44, "y": -34 },
            "kind": "SPECIAL",
            "label": "O"
          }
        ],
        "durationMs": 1600
      },
      {
        "id": "front",
        "order": 1,
        "phaseId": "outline",
        "title": "定位并描画主视图",
        "narration": "1. 先投出左右两个端面的定位线，确定总长 56 mm。\n2. 自下边起，沿四个角点依次描画主视轮廓，高度为 40 mm。",
        "kind": "DRAW",
        "entityIds": ["v-outline-1", "v-outline-2", "v-outline-3", "v-outline-4"],
        "constructionEntityIds": ["v-overrun-1"],
        "temporaryGuides": [
          {
            "id": "left-edge",
            "viewId": "view-0",
            "kind": "PROJECTION",
            "from": { "x": -16, "y": -54 },
            "to": { "x": -16, "y": 55 },
            "label": "长对正"
          },
          {
            "id": "right-edge",
            "viewId": "view-0",
            "kind": "PROJECTION",
            "from": { "x": -72, "y": -54 },
            "to": { "x": -72, "y": 55 }
          }
        ],
        "focusPoints": [
          {
            "id": "A",
            "position": { "x": -16, "y": 15 },
            "kind": "SPECIAL",
            "label": "A"
          },
          {
            "id": "B",
            "position": { "x": -72, "y": 15 },
            "kind": "GENERAL",
            "label": "B"
          }
        ],
        "durationMs": 2400
      },
      {
        "id": "transfer",
        "order": 2,
        "phaseId": "outline",
        "title": "传递长、高和宽",
        "narration": "1. 从主视图向下投出俯视轮廓，保持长对正。\n2. 向右投出高度，通过 45° 线传递俯视图深度，完成左视轮廓。",
        "kind": "DRAW",
        "entityIds": [
